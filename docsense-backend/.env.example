# ─── Aplicação ────────────────────────────────────────────────────────────────
APP_NAME=DocSense
ENVIRONMENT=development   # development | production
DEBUG=false

# ─── Segurança ────────────────────────────────────────────────────────────────
# Gere um valor seguro: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-uma-chave-segura-de-64-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Banco de dados ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://docsense:docsense@localhost:5432/docsense

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── IA — Chave de API ────────────────────────────────────────────────────────
# OBRIGATÓRIO: configure ao menos uma das chaves abaixo.
# O backend usa Groq (LLaMA3) por padrão. Obtenha em https://console.groq.com
GROQ_API_KEY=

# Alternativa: qualquer API compatível com OpenAI (ex: OpenRouter)
OPENAI_API_KEY=

# ─── Qdrant (vector store) ────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ─── CORS — adicione a URL do frontend em produção ────────────────────────────
# Exemplo para Netlify: ALLOWED_ORIGINS='["https://docsense-app.netlify.app"]'
# ALLOWED_ORIGINS=["http://localhost:3000"]
