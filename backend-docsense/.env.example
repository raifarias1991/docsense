# ─── DocSense Backend — variáveis de ambiente ────────────────────────────────
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env no git.

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false

# ── Segurança ─────────────────────────────────────────────────────────────────
# Gere um valor seguro com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-por-valor-seguro-gerado-acima
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── LLM — use Groq (gratuito) ou OpenAI ──────────────────────────────────────
# Groq: https://console.groq.com/keys  (tem free tier generoso)
# Sem uma dessas duas chaves, /api/v1/query retorna 503 ao pedir resposta
# gerada por IA (era a causa do erro "API key not configured" no frontend).
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (opcional, só se não usar Groq):
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Banco de dados (PostgreSQL) ───────────────────────────────────────────────
# Em produção (Render, Railway etc.) isso NÃO pode ser "localhost" — use o
# host do seu Postgres gerenciado (Neon, Supabase, Render Postgres...).
# Era a causa do erro "[Errno 111] Connection refused" no upload de documentos.
DATABASE_URL=postgresql+asyncpg://docsense:docsense@localhost:5432/docsense

# ── Qdrant (vector store) ────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=docsense_chunks

# ── Redis (cache opcional de respostas — app funciona sem ele) ───────────────
REDIS_URL=redis://localhost:6379
QUERY_CACHE_TTL_SECONDS=300

# ── Pipeline de ingestão / embeddings ────────────────────────────────────────
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_UPLOAD_SIZE_MB=10

# ── CORS — adicione a URL do seu frontend em produção ────────────────────────
# Aceita formato JSON ou lista separada por vírgulas.
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:3001","https://docsense-app.netlify.app"]
