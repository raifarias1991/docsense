# ─── DocSense Frontend — Variáveis de Ambiente ────────────────────────────────
#
# RENOMEIE este arquivo para .env.local para desenvolvimento local.
# Em produção (Netlify/Vercel), configure estas variáveis no painel do serviço.

# ─── URL do Backend ───────────────────────────────────────────────────────────
# SERVER-SIDE ONLY — não é exposta ao browser.
# Usada pelo proxy do Next.js (next.config.mjs) para encaminhar /api/v1/* ao backend.
# Em produção: URL pública do seu backend FastAPI.
API_URL=http://localhost:8000
